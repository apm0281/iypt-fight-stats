{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "iypt-frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "frontend"],
      "port": 8080
    },
    {
      "name": "iypt-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--app-dir", "backend"],
      "port": 8001
    }
  ]
}
